# Copy to terraform.tfvars. That file is gitignored because it holds the database password.
# Full steps: deploy/KUBERNETES.md

# --- Laptop cluster (kind) ---
target      = "local"
db_password = "replace-with-a-real-password"

# --- AWS (EKS). Destroy the local cluster before switching target. ---
# target                  = "aws"
# aws_region              = "us-east-1"
# aws_profile             = "default"
# kubernetes_version      = "1.35"
# aws_node_instance_type  = "t3.medium"
# db_password             = "replace-with-a-real-password"

# Optional on either target, once the cluster can pull the images:
# api_image = "ghcr.io/your-org/comforce-api:latest"
# web_image = "ghcr.io/your-org/comforce-web:latest"
# ingress_enabled = true
# ingress_host    = "comforce.example.org"

# A cluster you already have (k3s, a lab cluster, GKE, AKS):
# target          = "existing"
# kubeconfig_path = "~/.kube/config"
# db_password     = "replace-with-a-real-password"
