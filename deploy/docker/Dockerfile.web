FROM node:22-alpine AS build

# Keep the repository layout so src/client can import data/processed/hubs.json.
WORKDIR /src/src/client

COPY src/client/package.json src/client/package-lock.json ./
RUN npm ci

COPY src/client/ ./
COPY data/processed/hubs.json /src/data/processed/hubs.json

RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/src/client/dist /usr/share/nginx/html

EXPOSE 80
