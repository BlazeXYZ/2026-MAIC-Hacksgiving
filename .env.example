# ==============================================================================
# 2026 MAIC Hacksgiving - Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file or API keys to GitHub!

# Application Configuration
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
APP_SECRET_KEY=change-this-in-production

# AI / LLM Provider Keys (uncomment and populate what your team uses)
# ------------------------------------------------------------------------------
# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Hugging Face / Open Source Models
HUGGINGFACE_API_TOKEN=your-hf-token-here

# Vector Database / Embeddings (if using cloud/external vector stores)
# ------------------------------------------------------------------------------
# PINECONE_API_KEY=your-pinecone-api-key-here
# PINECONE_ENVIRONMENT=us-east-1
# CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Database / Storage
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/app.db

# Nonprofit Partner Custom API Keys / Webhooks (if provided)
# ------------------------------------------------------------------------------
# NONPROFIT_API_KEY=your-partner-api-key
# NONPROFIT_ENDPOINT_URL=https://api.partner.org/v1
