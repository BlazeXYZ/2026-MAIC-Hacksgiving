# ==============================================================================
# Git Ignore - 2026 MAIC Hacksgiving
# ==============================================================================

# Environment & Secrets (CRITICAL: Never commit API keys or sensitive data)
.env
.env.*
!.env.example
*.env
*.key
*.pem
credentials.json
client_secret*.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Jupyter Notebooks & Data Science
.ipynb_checkpoints/
*-checkpoint.ipynb
.virtual_documents/

# Datasets & Large Model Weights (Keep repo lightweight for fast pulls)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.csv
*.parquet
*.feather
*.sqlite
*.sqlite3
*.db
!data/samples/*

# Model Artifacts & Checkpoints
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.h5
*.pkl
*.joblib
checkpoints/
models/*
!models/.gitkeep

# Vector Database Stores
chroma_db/
faiss_index/
milvus_data/

# Node / Web Frontend (if fullstack)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.next/
out/
.nuxt/
.vuepress/dist
.cache/

# IDEs & System Files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs & Temporary Files
*.log
logs/
temp/
tmp/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
crash.log
override.tf
override.tf.json
